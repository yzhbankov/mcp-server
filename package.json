{
  "name": "mcp-server",
  "version": "1.0.0",
  "description": "Production-ready Model Context Protocol (MCP) server implementing JSON-RPC 2.0 over WebSocket for AI tool orchestration",
  "type": "module",
  "engines": {
    "node": ">=25.0.0",
    "npm": ">=11.6.2"
  },
  "scripts": {
    "start:server": "cd apps/server && yarn start",
    "start:client": "cd apps/client && yarn start"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yzhbankov/mcp-server.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "json-rpc",
    "websocket",
    "ai",
    "openai",
    "gpt",
    "automation",
    "tool-orchestration",
    "typescript"
  ],
  "author": {
    "name": "Dr. Zhbankov Yaroslav",
    "url": "https://github.com/yzhbankov"
  },
  "workspaces": [
    "apps/server",
    "apps/client"
  ],
  "private": true,
  "dependencies": {
    "lerna": "^9.0.0"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  },
  "license": "MIT"
}
